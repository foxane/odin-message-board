<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('./partials/head', {title: 'Message Board'}) %>
  </head>
  <body>
    <header>
      <%- include('./partials/header') %>
    </header>

    <% messages.forEach(item => { %>
      <%- include('./partials/message', {item: item}) %>
    <% }) %>

    <%- include('./partials/pagination', {currentPage, pageCount}) %>
    <%- include('./partials/footer') %>
  </body>
</html>
